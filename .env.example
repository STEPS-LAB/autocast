# ─────────────────────────────────────────────────────────────────────────────
# Autocast — environment variables
#
# Copy to `.env.local` for local dev, or to `.env` on the VPS (Docker Compose
# reads `.env` automatically).
#
# NOTE: every NEXT_PUBLIC_* value is inlined into the client bundle at
# `next build` time, NOT read at runtime. Changing one requires a rebuild.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Required: Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Required: public origin ─────────────────────────────────────────────────
# Used for auth redirects, password-reset emails, sitemap and OG metadata.
# Without it, links generated outside a request fall back to localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Node server (standalone `server.js`) ────────────────────────────────────
# 0.0.0.0 is required inside Docker; use 127.0.0.1 when running bare behind nginx.
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# ─── Optional: Sentry ────────────────────────────────────────────────────────
# Leave empty to disable error reporting entirely.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ─── Optional: SMTP (contact form, order notifications) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=

# ─── Optional: Nova Poshta shipping ──────────────────────────────────────────
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_SENDER_CITY_REF=

# ─── Optional: catalog revalidation webhook ──────────────────────────────────
# Shared secret for POST /api/cron/revalidate-catalog
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── Optional: multi-instance deploys only ───────────────────────────────────
# Keeps Server Actions working across several instances or rolling restarts.
# Generate with: openssl rand -base64 32
# Must be set at BUILD time, not just at runtime.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
